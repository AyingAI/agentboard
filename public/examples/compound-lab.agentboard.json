t:15px;width:15px;border:4px solid white;border-radius:50%;background:#7562e4;box-shadow:0 0 0 1px #dcd7f9}input:focus-visible,button:focus-visible{outline:3px solid #b6aaf7;outline-offset:5px}.range-labels{display:flex;justify-content:space-between;color:#8a90a4;font-size:11px}.presets{display:flex;gap:6px;flex-wrap:wrap;margin:19px 0 25px}.presets button{min-width:35px;flex:1;border:1px solid #e5e7f0;background:#fff;border-radius:9px;padding:7px 3px;font:inherit;font-size:12px;color:#747a90;cursor:pointer;transition:background .15s,color .15s}.presets button[aria-pressed=true]{background:#eeeafd;border-color:#d8d0fb;color:#6554d5;font-weight:700}.assumptions{border-top:1px solid #eef0f6;padding-top:17px}.assumption{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px;color:#858a9d;font-size:12px}.assumption strong{color:#30364e;font-size:14px;font-variant-numeric:tabular-nums}.tip{margin-top:auto;padding:14px;background:#f5f3fd;border-radius:12px;color:#6d638f;font-size:12px;line-height:1.7}.tip strong{display:block;color:#6250b1;margin-bottom:3px}.result-label{font-size:12px;color:#7c8298}.balance{display:flex;align-items:baseline;gap:8px;margin:4px 0 15px}.balance output{font-size:clamp(35px,4.7vw,49px);line-height:1.2;font-weight:750;letter-spacing:-1.8px;color:#292441;font-variant-numeric:tabular-nums}.balance span{font-size:13px;color:#8a8da0}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:15px;padding-bottom:17px;border-bottom:1px solid #f0f1f6}.metric{font-size:11px;color:#858a9c}.metric strong{display:block;font-size:17px;margin-top:3px;color:#454b64;font-variant-numeric:tabular-nums;font-weight:650}.metric.interest strong{color:#6855d7}.chart-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:17px;font-size:12px;color:#6e748b}.chart-heading strong{color:#555d75;font-weight:600}.chart-heading span{font-size:10px;color:#979bad}svg.chart{width:100%;height:auto;display:block;overflow:visible;margin-top:4px}.legend{display:flex;gap:17px;flex-wrap:wrap;color:#7b8195;font-size:11px}.legend span{display:flex;align-items:center;gap:6px}.legend i{display:inline-block;width:17px;height:3px;border-radius:4px;background:#7965df}.legend .simple i{background:transparent;height:0;border-top:2px dashed #9ca9b9;border-radius:0}.comparison{margin-top:15px;border-radius:12px;background:#f3f8f6;padding:12px 14px;color:#587365;font-size:12px}.comparison strong{color:#287052;font-variant-numeric:tabular-nums}.comparison small{display:block;color:#7e9387;font-size:10px;margin-top:4px}.formula{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:17px;padding:16px 20px;border-radius:15px;background:#eeeff7;border:1px solid #e3e5f0}.formula-label{color:#777d95;font-size:11px}.formula-value{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;color:#4c466c;font-size:17px;margin-top:3px}.formula-value sup{color:#7562d7}.explanation{flex:1;min-width:230px;color:#767c93;font-size:12px}.explanation strong{color:#5d527f}.growth-explanation{margin-top:17px;padding:18px 20px;background:#fff;border:1px solid #e5e7f1;border-radius:15px}.growth-explanation h2{margin:0 0 8px;color:#554880;font-size:14px;font-weight:650}.growth-explanation p{color:#72778d;font-size:12px;line-height:1.9}.growth-explanation strong{color:#6554b9;font-variant-numeric:tabular-nums}.footnote{margin-top:13px;color:#9196a8;font-size:10px;line-height:1.7}@media(max-width:720px){.app{padding:20px}.workspace{grid-template-columns:1fr}.header{flex-wrap:wrap}.control{display:block}.year-display{margin-bottom:8px}.year-display output{font-size:49px}.presets{margin-bottom:18px}.tip{margin-top:12px}.assumptions{display:grid;grid-template-columns:1fr 1fr;gap:15px}.assumption{display:block}.assumption strong{display:block}.balance output{font-size:44px}.formula{gap:12px}.chart-heading span{display:none}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}</style></head><body><main class='app'><header class='header'><div><div class='eyebrow'>THE COMPOUND EFFECT</div><h1>复利实验室</h1><p class='subtitle'>每年的收益，也能成为下一年的本金。</p></div><span class='badge'>数学模拟</span></header><div class='workspace'><section class='panel control' aria-label='模拟条件'><label class='section-label' for='years'>让这笔钱生长多久？</label><div class='year-display'><output id='years-value' for='years'>30</output><span>年</span></div><input id='years' name='years' type='range' min='1' max='30' step='1' value='30' aria-describedby='years-help'><div class='range-labels' id='years-help'><span>1 年</span><span>30 年</span></div><div class='presets' aria-label='快捷选择年份'><button id='preset-1' type='button' data-years='1' aria-pressed='false'>1年</button><button id='preset-5' type='button' data-years='5' aria-pressed='false'>5年</button><button id='preset-10' type='button' data-years='10' aria-pressed='false'>10年</button><button id='preset-20' type='button' data-years='20' aria-pressed='false'>20年</button><button id='preset-30' type='button' data-years='30' aria-pressed='true'>30年</button></div><div class='assumptions'><div class='assumption'><span>初始本金</span><strong>1,000 元</strong></div><div class='assumption'><span>假设年利率</span><strong>5%</strong></div><div class='assumption'><span>计息方式</span><strong>每年复利</strong></div></div><div class='tip'><strong>收益留下来，继续生长</strong>不追加、不取出。每年赚到的收益，全部投入下一年。</div></section><section class='panel' aria-label='复利计算结果'><p class='result-label'>第 <span id='selected-years'>30</span> 年末 · 本息总额</p><div class='balance'><output id='result' for='years' aria-live='polite' aria-atomic='true'>4,321.94</output><span>元</span></div><div class='metrics'><div class='metric'>投入本金<strong>1,000.00 <small>元</small></strong></div><div class='metric interest'>累计收益<strong><span id='interest'>3,321.94</span> <small>元</small></strong></div></div><div class='chart-heading'><strong>时间 × 增长</strong><span>圆点对应所选年份 · 完整曲线为 30 年</span></div><svg class='chart' id='growth-chart' viewBox='0 0 540 218' role='img' aria-labelledby='chart-title chart-description'></svg><div class='legend'><span><i aria-hidden='true'></i>复利：收益继续投入</span><span class='simple'><i aria-hidden='true'></i>单利：收益不再投入</span></div><div class='comparison' id='comparison-detail'>收益再投入，比单利多 <strong><span id='extra'>1,821.94</span> 元</strong><small>同期限单利本息：<span id='simple-balance'>2,500.00</span> 元；每年收益固定为 50 元。</small></div></section></div><section class='formula' aria-label='计算过程'><div><div class='formula-label'>复利公式 · 本金 × (1 + 年利率) 的年数次方</div><div class='formula-value'>1,000 × (1 + 5%)<sup id='formula-years'>30</sup></div></div><p class='explanation' id='year-explanation'></p></section><section class='growth-explanation' aria-labelledby='growth-explanation-title' data-agentboard-id='growth-explanation'><h2 id='growth-explanation-title'>同样是 5%，为什么收益会越来越多？</h2><p id='growth-explanation-text'>第 1 年，本金 1,000.00 元带来 <strong>50.00 元</strong>收益。收益逐年再投入，到第 30 年，计息基数已增至 <strong>4,116.14 元</strong>，该年的收益为 <strong>205.81 元</strong>，约为第 1 年的 <strong>4.12 倍</strong>；30 年累计收益为 <strong>3,321.94 元</strong>。每年新增的收益继续参与计息，所以后期每年增加的金额越来越多，曲线也越来越陡；假设年利率始终为 5%。</p></section><p class='footnote'>数学模拟：假设年利率始终为 5%，每年末计息，收益全部再投入，不计费用与税费。金额仅在展示时保留两位小数，曲线不代表实际投资表现。年份选择自动保存。</p></main><script>(()=>{const principal=1000,rate=0.05;const bridge=window.agentboard;const slider=document.getElementById('years');const chart=document.getElementById('growth-chart');const buttons=Array.from(document.querySelectorAll('[data-years]'));const money=n=>n.toLocaleString('zh-CN',{minimumFractionDigits:2,maximumFractionDigits:2});const text=(id,value)=>{document.getElementById(id).textContent=value;};function readYears(state){const value=state&&state.years;const n=Number(value);return value===undefined||value===null||!Number.isFinite(n)?30:Math.min(30,Math.max(1,Math.round(n)));}function drawChart(years,total,simple){const x=t=>46+t/30*456;const y=v=>178-v/4500*157;const point=(t,v)=>x(t).toFixed(2)+','+y(v).toFixed(2);const values=Array.from({length:31},(_,t)=>principal*Math.pow(1+rate,t));const full=values.map((v,t)=>point(t,v)).join(' ');const selected=values.slice(0,years+1).map((v,t)=>point(t,v)).join(' ');let grid='';[0,1500,3000,4500].forEach(v=>{grid+=`<line x1='46' x2='502' y1='${y(v)}' y2='${y(v)}' stroke='#eceef5'/><text x='36' y='${y(v)+4}' text-anchor='end' fill='#9b9fb1' font-size='10'>${v.toLocaleString('zh-CN')}</text>`;});[0,10,20,30].forEach(t=>{grid+=`<text x='${x(t)}' y='199' text-anchor='middle' fill='#9b9fb1' font-size='10'>${t}年</text>`;});const px=x(years),py=y(total),anchor=years>26?'end':'start',labelX=years>26?px-9:px+9;chart.innerHTML=`<title id='chart-title'>本金一千元，假设年利率百分之五的复利与单利曲线</title><desc id='chart-description'>展示零至三十年。当前选择${years}年，复利本息${money(total)}元，单利本息${money(simple)}元。</desc><defs><linearGradient id='growth-fill' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#9986ee' stop-opacity='.22'/><stop offset='100%' stop-color='#9986ee' stop-opacity='.02'/></linearGradient></defs>${grid}<polygon points='46,178 ${full} 502,178' fill='url(#growth-fill)'/><polygon points='46,178 ${selected} ${px},178' fill='#8c75e5' opacity='.10'/><line x1='46' y1='${y(principal)}' x2='502' y2='${y(2500)}' stroke='#9ca9b9' stroke-width='2' stroke-dasharray='5 5' data-agentboard-id='simple-curve'/><polyline points='${full}' fill='none' stroke='#c8bef1' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><polyline points='${selected}' fill='none' stroke='#7965df' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round' data-agentboard-id='compound-curve'/><line x1='${px}' x2='${px}' y1='${py}' y2='178' stroke='#9a87e5' stroke-dasharray='3 4'/><circle cx='${px}' cy='${py}' r='9' fill='#7965df' opacity='.13'/><circle cx='${px}' cy='${py}' r='5' fill='#7965df' stroke='white' stroke-width='2' data-agentboard-id='selected-year-point'/><text x='${labelX}' y='${Math.max(14,py-13)}' text-anchor='${anchor}' fill='#705ac8' font-size='11' font-weight='700'>${years}年</text>`;}function render(years,persist){const total=principal*Math.pow(1+rate,years);const simple=principal*(1+rate*years);const previous=principal*Math.pow(1+rate,years-1);slider.value=String(years);slider.style.setProperty('--progress',((years-1)/29*100)+'%');slider.setAttribute('aria-valuetext',years+'年');text('years-value',years);text('selected-years',years);text('result',money(total));text('interest',money(total-principal));text('extra',money(Math.max(0,total-simple)));text('simple-balance',money(simple));text('formula-years',years);document.getElementById('year-explanation').innerHTML=`第 ${years} 年的收益为 <strong>${money(previous*rate)} 元</strong><br>上一年末 ${money(previous)} 元 × 5%`;document.getElementById('growth-explanation-text').innerHTML=years===1?`第 1 年，本金 ${money(principal)} 元带来 <strong>${money(principal*rate)} 元</strong>收益。将这笔收益全部再投入，下一年的计息基数就会变成 <strong>${money(total)} 元</strong>，第 2 年可获得 <strong>${money(total*rate)} 元</strong>收益。每年新增的收益继续参与计息，所以后期每年增加的金额越来越多，曲线也越来越陡；假设年利率始终为 5%。`:`第 1 年，本金 ${money(principal)} 元带来 <strong>${money(principal*rate)} 元</strong>收益。收益逐年再投入，到第 ${years} 年，计息基数已增至 <strong>${money(previous)} 元</strong>，该年的收益为 <strong>${money(previous*rate)} 元</strong>，约为第 1 年的 <strong>${(previous/principal).toFixed(2)} 倍</strong>；${years} 年累计收益为 <strong>${money(total-principal)} 元</strong>。每年新增的收益继续参与计息，所以后期每年增加的金额越来越多，曲线也越来越陡；假设年利率始终为 5%。`;buttons.forEach(button=>button.setAttribute('aria-pressed',String(Number(button.dataset.years)===years)));drawChart(years,total,simple);if(persist&&bridge&&typeof bridge.setState==='function'){bridge.setState({years});}}slider.addEventListener('input',()=>render(readYears({years:slider.value}),true));buttons.forEach(button=>button.addEventListener('click',()=>render(Number(button.dataset.years),true)));let saved={};if(bridge&&typeof bridge.getState==='function'){saved=bridge.getState()||{};}render(readYears(saved),false);if(bridge&&typeof bridge.onStateChange==='function'){bridge.onStateChange(state=>{const restored=state||bridge.getState()||{};render(readYears(restored),false);});}})();</script></body></html>",
